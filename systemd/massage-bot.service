[Unit]
Description=VK massage booking bot
Documentation=https://github.com/Mikaso-Nakamoto/potential-funicular
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# ВАЖНО: замените USER и путь в WorkingDirectory на свои
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/massage-bot
ExecStart=/usr/bin/python3 -m bot.main
Restart=always
RestartSec=5
# аккуратная остановка: бот успевает отправить очередь
KillSignal=SIGTERM
TimeoutStopSec=20
# лог в journald: journalctl -u massage-bot -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=massage-bot

# --- минимальная изоляция (необязательно, но полезно) ---
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/YOUR_USER/massage-bot/data

[Install]
WantedBy=multi-user.target

# OS & Editor files
.DS_Store
Thumbs.db
*.swp

# Dependencies & Environments
node_modules/
.venv/
venv/
__pycache__/

# Local credentials and account-specific configuration
.env
.env.*
!.env.example
.npmrc
config/local/

# Generated private outputs
outputs/

# Private keys and signing material
*.key
*.pem
*.p12
*.pfx
*.keystore

# usb-kit runtime artifacts (собирается бутстрапом на носителе, не коммитится)
usb-kit/node/
usb-kit/npm-global/
usb-kit/venv/
usb-kit/tmp/
usb-kit/config/auth.json
usb-kit/config/mcp.log*
usb-kit/sessions/*
!usb-kit/sessions/.gitkeep
usb-kit/config/skills/*
!usb-kit/config/skills/.gitkeep

# готовые архивы для раздачи (собираются локально)
/usb-kit.zip

# однофайловый установщик (генерируется tools/make-single-bat.py)
/USB-KIT.bat

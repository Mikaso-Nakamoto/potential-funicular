# =============================================================================
#  Секреты бота. Скопируйте:  cp .env.example .env   и заполните.
#  Файл .env в git НЕ попадает (см. .gitignore). Права: chmod 600 .env
#  Как получить значения — пошагово в docs/VK_SETUP.md
# =============================================================================

# id сообщества ВКонтакте (число, не "club123456", а 123456)
VK_GROUP_ID=000000000

# Ключ доступа сообщества с правами "сообщения" (Settings → API usage → Keys)
VK_GROUP_TOKEN=vk1.a.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Числовой id страницы мастера, куда слать заявки (можно несколько через запятую)
# Узнать свой id: scripts/doctor.py --whoami
ADMIN_VK_IDS=000000000

# Необязательно: переопределить путь к базе (по умолчанию data/massage.sqlite3)
# DB_PATH=/home/lena/massage-bot/data/massage.sqlite3
